{
  "name": "fupu-carousel-ws",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build fupu-carousel && ng build demo",
    "build:lib": "ng build fupu-carousel",
    "build:demo": "ng build demo",
    "watch": "ng build fupu-carousel --watch --configuration development",
    "test": "ng test fupu-carousel --watch=false",
    "test:demo": "ng test demo --watch=false",
    "serve:ssr:demo": "node dist/demo/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^26.1.0",
    "ng-packagr": "^22.1.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
