{
  "name": "ngx-fy-carousel-ws",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-fy-carousel && ng build demo",
    "build:lib": "ng build ngx-fy-carousel",
    "build:demo": "ng build demo",
    "watch": "ng build ngx-fy-carousel --watch --configuration development",
    "test": "ng test ngx-fy-carousel --watch=false",
    "test:demo": "ng test demo --watch=false",
    "serve:ssr:demo": "node dist/demo/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-server": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/ssr": "^21.2.19",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^26.1.0",
    "ng-packagr": "^21.2.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
